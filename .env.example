# =============================================================================
# DE RUEDA CONSTRUCTION ERP - ENVIRONMENT VARIABLE SPECIFICATION
# Aligned strictly with "SECRET VALUE — PARTIALLY RESOLVED" (Configuration Status)
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Server Session & Cryptographic Secrets (Required)
# -----------------------------------------------------------------------------
# Generate strong, distinct random values locally; keep private. Never reuse SESSION_SECRET.
SESSION_SECRET=
PBKDF2_PEPPER=

# -----------------------------------------------------------------------------
# 2. Database & Persistent Storage Directory (Configuration, not a secret)
# -----------------------------------------------------------------------------
DATABASE_DIR=./data

# -----------------------------------------------------------------------------
# 3. Gemini API Key (Server-Side Construction Document Classifier & DOLE Advisor)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 4. PayMongo Philippines (STATUS: ON HOLD — Provider Maintenance Issue)
# -----------------------------------------------------------------------------
# Live payments & disbursements are ON HOLD. Do not attempt live payments until
# upstream service and account access are confirmed. Simulation mode is active.
PAYMONGO_ENVIRONMENT=sandbox
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 5. Email Integration (Planned for Payslip & DTR Summaries)
# -----------------------------------------------------------------------------
# Send payslips by email only after confirmed payout or confirmed cash handover.
# Use authorized provider-issued credentials or OAuth; never use a personal mailbox password.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="De Rueda Payroll <payroll@deruedaconstruction.com>"

# -----------------------------------------------------------------------------
# RETIRED / REMOVED INTEGRATIONS (Per Section 1 & 2 of Specification):
# - Separate GCash API (GCASH_API_KEY, GCASH_API_SECRET, GCASH_MERCHANT_ID, GCASH_WEBHOOK_SIGNING)
#   REMOVED: GCash flows route through PayMongo only where supported. No separate API needed.
# - SMS Provider (SMS_PROVIDER, SMS_API_KEY, SMS_SENDER_NAME)
#   REMOVED: SMS delivery removed from planned workflow; replaced by email delivery.
# -----------------------------------------------------------------------------
