# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key (Server-side AI document classification & assistant)
GEMINI_API_KEY=

# PayMongo Payment & Disbursement Gateway (Server-Side Only)
# Store production secrets here or in secrets manager; never in frontend code
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET_KEY=
PAYMONGO_ENVIRONMENT=sandbox
